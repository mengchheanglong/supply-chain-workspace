# Local orchestration only. Passwords live in .secrets/, generated by Setup.ps1.
COMPOSE_PROJECT_NAME=supply-chain-workspace
POSTGIS_IMAGE=postgis/postgis:18-3.6
POSTGRES_HOST_PORT=5433
POSTGRES_ADMIN_USER=workspace_admin
ROUTING_HOST_PORT=3000
# Demo routing is for UI development. It is not an enterprise validation input.
ROUTING_LOG_LEVEL=info
# Optional real extract path, relative to the workspace; used by compose.osm.yaml.
OSM_PBF_PATH=./osm-pathfinder/data/cambodia-latest.osm.pbf
